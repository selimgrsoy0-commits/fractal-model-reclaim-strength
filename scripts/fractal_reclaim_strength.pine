//@version=6
indicator("Fractal Model - Reclaim Strength (RS) Engine", "FM·RS", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

// ==========================================
// 1. INPUTS & SETTINGS (LEAN & MINIMAL)
// Reference: notprofgreen "one setup" visual — two levels:
// the swept C1 extreme + the must-hold C2 extreme. No entry/TP.
// ==========================================
grp_visual = "1. LEVELS"
grp_table  = "2. STATS TABLE"

// --- 1. LEVELS (C1 Swept + C2 Extreme) ---
show_lines       = input.bool(true, "Level Lines (C1 & C2 Extreme)", group=grp_visual, tooltip="Draws the swept C1 extreme and the must-hold C2 extreme.")
show_line_labels = input.bool(true, "Price Labels", group=grp_visual, tooltip="Shows the level price at the right end of the line.")

// --- 2. STATS TABLE ---
show_tbl    = input.bool(true, "Show Table", inline="tbl_view", group=grp_table, tooltip="Shows live setup status and historical hit rates.")
tbl_pos     = input.string("Top Right", "Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], inline="tbl_view", group=grp_table)
tbl_size_in = input.string("Small", "Size", options=["Small", "Tiny", "Normal"], inline="tbl_view", group=grp_table)
bars_mode   = input.string("All Available Bars", "Sample", options=["All Available Bars", "Last 5000 Bars", "Last 1000 Bars", "Last 500 Bars"], group=grp_table, tooltip="How many past bars feed the table statistics. Windowed modes re-filter on every bar close, so old setups drop out as new ones arrive.")

// ==========================================
// 2. HELPERS & FUNCTIONS
// ==========================================
// Timeframe gate (hard 15m rule: engine, drawings and table fully hidden below 15 minutes)
int tf_sec = timeframe.in_seconds()
bool is_too_low = na(tf_sec) ? ((timeframe.isseconds) or (timeframe.isminutes and timeframe.multiplier < 15)) : (tf_sec < 900)

get_bin(float rs) =>
    int b = 0
    if rs < 10.0
        b := 0
    else if rs < 25.0
        b := 1
    else if rs < 50.0
        b := 2
    else if rs < 75.0
        b := 3
    else if rs < 100.0
        b := 4
    else
        b := 5
    b

bin_label(int b) =>
    switch b
        0 => "0–10%"
        1 => "10–25%"
        2 => "25–50%"
        3 => "50–75%"
        4 => "75–100%"
        5 => "≥100%"
        => "–"

format_pct(float val) =>
    na(val) ? "–" : str.tostring(val, "0.0") + "%"

format_delta(float val) =>
    na(val) ? "–" : (val > 0.0 ? "+" : "") + str.tostring(val, "0.0") + "%"

// ==========================================
// 3. EVENT STORE + COUNTERS (6 BINS + BASE)
// Every closed setup is stored once (C2 bar + packed outcome).
// Counters rebuild from the store on each confirmed bar, so
// windowed samples ("Last 500") stay exact as bars stream in:
// old setups drop out, new ones come in. Matches the reference
// matrix bins: [10,25,50,75,100], side='right'.
// code packing: bin | reaches?8 | full?16 | xc2?32
// ==========================================
var int[] ev_bar  = array.new_int()
var int[] ev_code = array.new_int()

var int[] bin_n       = array.new_int(6, 0)
var int[] bin_reaches = array.new_int(6, 0)
var int[] bin_full    = array.new_int(6, 0)
var int[] bin_xc2     = array.new_int(6, 0)

var int total_n       = 0
var int total_reaches = 0
var int total_full    = 0
var int total_xc2     = 0

// Sample window (scoped on the setup's own C2 bar)
int max_lookback = switch bars_mode
    "Last 5000 Bars" => 5000
    "Last 1000 Bars" => 1000
    "Last 500 Bars"  => 500
    => 1000000

// ==========================================
// 4. HISTORICAL EVENT MEASUREMENT ENGINE
// On bar [0]'s close, the C2 setup at [2] gets its final C3 ([1])
// and C4 ([0]) outcome. Sweep is wick-based, reclaim is
// close-based ("This close is the event").
// Breach is strict < / >; equality holds (not a live stop rule).
// ==========================================
if bar_index >= 3 and barstate.isconfirmed and not is_too_low
    float c1_h = high[3]
    float c1_l = low[3]
    float c1_rng = c1_h - c1_l

    float c2_h = high[2]
    float c2_l = low[2]
    float c2_c = close[2]
    float c2_rng = c2_h - c2_l

    if c1_rng > 0.0 and c2_rng > 0.0
        bool bull_2 = (c2_l < c1_l) and (c2_c > c1_l)
        bool bear_2 = (c2_h > c1_h) and (c2_c < c1_h)
        bool dual_2 = bull_2 and bear_2 // dual-direction outside bars excluded

        bool is_bull_2 = bull_2 and not dual_2
        bool is_bear_2 = bear_2 and not dual_2

        if is_bull_2 or is_bear_2
            float rs_2 = is_bull_2 ? (100.0 * (c2_c - c1_l) / c1_rng) : (100.0 * (c1_h - c2_c) / c1_rng)

            bool f3 = is_bull_2 ? (low[1] < c2_l) : (high[1] > c2_h)
            bool f4 = is_bull_2 ? (low[0] < c2_l) : (high[0] > c2_h)

            bool reaches = not f3
            bool full    = (not f3) and (not f4)
            bool xc2     = f3 or f4

            int b = get_bin(rs_2)
            int code = b + (reaches ? 8 : 0) + (full ? 16 : 0) + (xc2 ? 32 : 0)
            array.push(ev_bar, bar_index - 2)
            array.push(ev_code, code)

    // Rebuild counters from the store (confirmed bars only, so
    // realtime ticks never pay the loop; history loads append
    // first and recount once per close — O(n), not O(n²)).
    array.fill(bin_n, 0)
    array.fill(bin_reaches, 0)
    array.fill(bin_full, 0)
    array.fill(bin_xc2, 0)
    total_n       := 0
    total_reaches := 0
    total_full    := 0
    total_xc2     := 0
    int ev_total = array.size(ev_bar)
    if ev_total > 0
        for i = 0 to ev_total - 1
            if (last_bar_index - array.get(ev_bar, i)) <= max_lookback
                int code_i = array.get(ev_code, i)
                int b_i = code_i % 8
                bool r_i = math.floor(code_i / 8) % 2 == 1
                bool f_i = math.floor(code_i / 16) % 2 == 1
                bool x_i = math.floor(code_i / 32) % 2 == 1
                array.set(bin_n, b_i, array.get(bin_n, b_i) + 1)
                total_n += 1
                if r_i
                    array.set(bin_reaches, b_i, array.get(bin_reaches, b_i) + 1)
                    total_reaches += 1
                if f_i
                    array.set(bin_full, b_i, array.get(bin_full, b_i) + 1)
                    total_full += 1
                if x_i
                    array.set(bin_xc2, b_i, array.get(bin_xc2, b_i) + 1)
                    total_xc2 += 1

// ==========================================
// 5. ACTIVE C2 SETUP TRACKING
// ==========================================
float c1_h_now = high[1]
float c1_l_now = low[1]
float c1_rng_now = c1_h_now - c1_l_now

float c2_h_now = high[0]
float c2_l_now = low[0]
float c2_c_now = close[0]
float c2_rng_now = c2_h_now - c2_l_now

bool valid_now = (c1_rng_now > 0.0) and (c2_rng_now > 0.0)
bool bull_now  = (c2_l_now < c1_l_now) and (c2_c_now > c1_l_now)
bool bear_now  = (c2_h_now > c1_h_now) and (c2_c_now < c1_h_now)
bool dual_now  = bull_now and bear_now

bool is_bull_now  = valid_now and bull_now and not dual_now
bool is_bear_now  = valid_now and bear_now and not dual_now
bool is_setup_now = is_bull_now or is_bear_now

var string active_dir        = ""
var int    active_c2_bar     = na
var float  active_c2_h       = na
var float  active_c2_l       = na
var float  active_rs         = na
var float  active_wick       = na
var float  active_swept      = na
var float  active_extreme    = na
var bool   active_failed     = false
var int    active_failed_bar = na
var int    active_bin        = -1

// Active setup updates when C2 closes
if barstate.isconfirmed and is_setup_now and not is_too_low
    active_dir        := is_bull_now ? "Bull" : "Bear"
    active_c2_bar     := bar_index
    active_c2_h       := c2_h_now
    active_c2_l       := c2_l_now
    active_failed     := false
    active_failed_bar := na
    active_rs         := is_bull_now ? (100.0 * (c2_c_now - c1_l_now) / c1_rng_now) : (100.0 * (c1_h_now - c2_c_now) / c1_rng_now)
    active_wick       := is_bull_now ? (100.0 * (c1_l_now - c2_l_now) / c2_rng_now) : (100.0 * (c2_h_now - c1_h_now) / c2_rng_now)
    active_swept      := is_bull_now ? c1_l_now : c1_h_now
    active_extreme    := is_bull_now ? c2_l_now : c2_h_now
    active_bin        := get_bin(active_rs)

// C2 extreme breach check while the setup is live (C3 and C4).
// Note: the stats engine above is isconfirmed-gated; this block
// is the live status board and updates intrabar.
if not na(active_c2_bar) and bar_index > active_c2_bar and bar_index <= active_c2_bar + 2 and not is_too_low
    bool is_fail_now = (active_dir == "Bull" and low < active_c2_l) or (active_dir == "Bear" and high > active_c2_h)
    if is_fail_now and not active_failed
        active_failed     := true
        active_failed_bar := bar_index

// Setup expiry (C4 close)
bool is_setup_expired = not na(active_c2_bar) and (bar_index > active_c2_bar + 2)

// ==========================================
// 6. ACTIVE SETUP LINES (C1 Swept + C2 Extreme)
// The two reference lines: swept level (gray dotted) and the
// must-hold extreme (direction color, dashed). On breach the
// extreme line turns red; no third line is ever drawn.
// ==========================================
var line  l_swept     = na
var line  l_extreme   = na
var label lbl_extreme = na

color bull_col = color.rgb(16, 185, 129)
color bear_col = color.rgb(244, 63, 94)
color fail_col = color.rgb(239, 68, 68)

if is_too_low or not show_lines
    if not na(l_swept)
        line.delete(l_swept)
        l_swept := na
    if not na(l_extreme)
        line.delete(l_extreme)
        l_extreme := na
    if not na(lbl_extreme)
        label.delete(lbl_extreme)
        lbl_extreme := na
else if not na(active_c2_bar)
    int end_bar = active_c2_bar + 2
    color dir_col = active_dir == "Bull" ? bull_col : bear_col

    // Fresh C2 close: rebuild lines from scratch
    if barstate.isconfirmed and is_setup_now
        if not na(l_swept)
            line.delete(l_swept)
        if not na(l_extreme)
            line.delete(l_extreme)
        if not na(lbl_extreme)
            label.delete(lbl_extreme)
        l_swept   := na
        l_extreme := na
        lbl_extreme := na

        l_swept := line.new(active_c2_bar - 1, active_swept, end_bar, active_swept,
             color=color.rgb(148, 163, 184), style=line.style_dotted, width=1)
        l_extreme := line.new(active_c2_bar, active_extreme, end_bar, active_extreme,
             color=dir_col, style=line.style_dashed, width=2)

        if show_line_labels
            lbl_extreme := label.new(end_bar, active_extreme,
                 text="C2 Extreme: " + str.tostring(active_extreme, format.mintick),
                 style=label.style_label_left,
                 color=dir_col,
                 textcolor=color.white,
                 size=size.tiny)

    // Live C2 extreme breach: visual state
    if active_failed
        if not na(l_extreme)
            line.set_color(l_extreme, fail_col)
        if not na(lbl_extreme)
            label.set_color(lbl_extreme, fail_col)
            label.set_text(lbl_extreme, "C2 Extreme (Broken ✗): " + str.tostring(active_extreme, format.mintick))

    if not show_line_labels
        if not na(lbl_extreme)
            label.delete(lbl_extreme)
            lbl_extreme := na

    // Setup expiry (C4 close): wipe all lines
    if is_setup_expired
        if not na(l_swept)
            line.delete(l_swept)
        if not na(l_extreme)
            line.delete(l_extreme)
        if not na(lbl_extreme)
            label.delete(lbl_extreme)
        l_swept     := na
        l_extreme   := na
        lbl_extreme := na

// ==========================================
// 7. COMPACT STATS + ACTIVE SETUP TABLE
// ==========================================
var string table_pos_id = switch tbl_pos
    "Bottom Right" => position.bottom_right
    "Top Left"     => position.top_left
    "Bottom Left"  => position.bottom_left
    => position.top_right

var string table_sz = switch tbl_size_in
    "Normal" => size.normal
    "Small"  => size.small
    => size.tiny

var table t = na

if barstate.islast
    if is_too_low
        if not na(t)
            table.delete(t)
            t := na
    else if show_tbl
        if na(t)
            t := table.new(table_pos_id, 6, 10, bgcolor=color.rgb(15, 23, 42), border_color=color.rgb(51, 65, 85), border_width=1)

        float taban_full_pct    = total_n > 0 ? (total_full * 100.0 / total_n) : na
        float taban_reaches_pct = total_n > 0 ? (total_reaches * 100.0 / total_n) : na
        float taban_xc2_pct     = total_n > 0 ? (total_xc2 * 100.0 / total_n) : na

        // Row 0: Main Title
        string tf_str = switch
            timeframe.isseconds       => timeframe.period + "s"
            timeframe.period == "60"  => "1h"
            timeframe.period == "240" => "4h"
            timeframe.isminutes       => timeframe.period + "m"
            timeframe.isdaily         => "Daily"
            timeframe.isweekly        => "Weekly"
            timeframe.ismonthly       => "Monthly"
            => timeframe.period

        string header_txt = "FM · RS ENGINE (" + syminfo.ticker + " · " + tf_str + ")"
        table.cell(t, 0, 0, header_txt, bgcolor=color.rgb(24, 29, 43), text_color=color.rgb(248, 250, 252), text_size=table_sz)
        table.merge_cells(t, 0, 0, 5, 0)

        // Row 1: Active Setup Status Board (compact single line)
        bool is_live = not na(active_c2_bar) and (bar_index - active_c2_bar <= 2)
        string phase_txt = ""
        if is_live
            int bars_since = bar_index - active_c2_bar
            phase_txt := bars_since == 0 ? "C2" : (bars_since == 1 ? "C3" : "C4")

        string active_banner = ""
        color  active_bg     = color.rgb(30, 41, 59)

        if is_live
            if active_failed
                string fail_phase = not na(active_failed_bar) ? (active_failed_bar - active_c2_bar == 1 ? "C3" : "C4") : phase_txt
                active_banner := "INVALIDATED: " + active_dir + " (" + fail_phase + ") · C2 Extreme Broken"
                active_bg     := color.rgb(71, 85, 105)
            else
                active_banner := "LIVE: " + active_dir + " (" + phase_txt + ") · RS: %" + str.tostring(active_rs, "0.0") + " · Wick: %" + str.tostring(active_wick, "0.0")
                active_bg     := active_dir == "Bull" ? color.rgb(6, 78, 59) : color.rgb(136, 19, 55)
        else
            active_banner := "STANDBY" + (active_dir != "" ? " (Last: " + active_dir + " · %" + str.tostring(active_rs, "0.0") + (active_failed ? " · Invalidated)" : ")") : "")
            active_bg := color.rgb(30, 41, 59)

        table.cell(t, 0, 1, active_banner, bgcolor=active_bg, text_color=color.rgb(248, 250, 252), text_size=table_sz)
        table.merge_cells(t, 0, 1, 5, 1)

        // Row 2: Column Headers (compact)
        table.cell(t, 0, 2, "RS", bgcolor=color.rgb(30, 41, 59), text_color=color.rgb(203, 213, 225), text_size=table_sz)
        table.cell(t, 1, 2, "N", bgcolor=color.rgb(30, 41, 59), text_color=color.rgb(203, 213, 225), text_size=table_sz)
        table.cell(t, 2, 2, "Reach C4", bgcolor=color.rgb(30, 41, 59), text_color=color.rgb(203, 213, 225), text_size=table_sz)
        table.cell(t, 3, 2, "Full C4", bgcolor=color.rgb(30, 41, 59), text_color=color.rgb(203, 213, 225), text_size=table_sz)
        table.cell(t, 4, 2, "XC2", bgcolor=color.rgb(30, 41, 59), text_color=color.rgb(203, 213, 225), text_size=table_sz)
        table.cell(t, 5, 2, "Base Δ", bgcolor=color.rgb(30, 41, 59), text_color=color.rgb(203, 213, 225), text_size=table_sz)

        // Rows 3..8: 6 RS bins
        for b = 0 to 5
            int row_idx = 3 + b
            int cnt = array.get(bin_n, b)
            float r_pct = cnt > 0 ? (array.get(bin_reaches, b) * 100.0 / cnt) : na
            float f_pct = cnt > 0 ? (array.get(bin_full, b) * 100.0 / cnt) : na
            float x_pct = cnt > 0 ? (array.get(bin_xc2, b) * 100.0 / cnt) : na
            float delta = (cnt > 0 and not na(taban_reaches_pct)) ? (r_pct - taban_reaches_pct) : na

            bool is_active_bucket = is_live and (active_bin == b)
            color row_bg = is_active_bucket ? color.rgb(30, 58, 95) : color.rgb(15, 23, 42)

            color lbl_col = b == 0 ? color.rgb(248, 113, 113) :
                 b == 1 ? color.rgb(251, 146, 60) :
                 b == 2 ? color.rgb(250, 204, 21) :
                 b == 3 ? color.rgb(52, 211, 153) :
                 b == 4 ? color.rgb(16, 185, 129) :
                          color.rgb(5, 150, 105)

            table.cell(t, 0, row_idx, bin_label(b), bgcolor=row_bg, text_color=lbl_col, text_size=table_sz)
            table.cell(t, 1, row_idx, str.tostring(cnt), bgcolor=row_bg, text_color=color.rgb(226, 232, 240), text_size=table_sz)
            table.cell(t, 2, row_idx, format_pct(r_pct), bgcolor=row_bg, text_color=color.rgb(226, 232, 240), text_size=table_sz)
            table.cell(t, 3, row_idx, format_pct(f_pct), bgcolor=row_bg, text_color=color.rgb(226, 232, 240), text_size=table_sz)
            table.cell(t, 4, row_idx, format_pct(x_pct), bgcolor=row_bg, text_color=color.rgb(248, 250, 252), text_size=table_sz)

            color delta_col = not na(delta) and delta > 0.0 ? color.rgb(52, 211, 153) :
                 not na(delta) and delta < 0.0 ? color.rgb(248, 113, 113) :
                 color.rgb(148, 163, 184)

            table.cell(t, 5, row_idx, format_delta(delta), bgcolor=row_bg, text_color=delta_col, text_size=table_sz)

        // Row 9: BASE (sample summary)
        table.cell(t, 0, 9, "BASE", bgcolor=color.rgb(24, 29, 43), text_color=color.rgb(248, 250, 252), text_size=table_sz)
        table.cell(t, 1, 9, str.tostring(total_n), bgcolor=color.rgb(24, 29, 43), text_color=color.rgb(248, 250, 252), text_size=table_sz)
        table.cell(t, 2, 9, format_pct(taban_reaches_pct), bgcolor=color.rgb(24, 29, 43), text_color=color.rgb(248, 250, 252), text_size=table_sz)
        table.cell(t, 3, 9, format_pct(taban_full_pct), bgcolor=color.rgb(24, 29, 43), text_color=color.rgb(248, 250, 252), text_size=table_sz)
        table.cell(t, 4, 9, format_pct(taban_xc2_pct), bgcolor=color.rgb(24, 29, 43), text_color=color.rgb(248, 250, 252), text_size=table_sz)
        table.cell(t, 5, 9, "Ref", bgcolor=color.rgb(24, 29, 43), text_color=color.rgb(148, 163, 184), text_size=table_sz)
    else
        if not na(t)
            table.delete(t)
            t := na
